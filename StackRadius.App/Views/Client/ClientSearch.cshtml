@using System.Data

@model StackRadius.Entity.ClientModel
@{
    ViewBag.Title = "Client Search";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Advanced Select -->
<div class="container-fluid">
    <!-- Exportable Table -->
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="card">
                <div class="header">
                    <h2>
                       Client
                    </h2>
                </div>
                <div class="body">                   
                    <form id="ClientScreen" role="form" class="form-horizontal" method="post" action="" enctype="multipart/form-data">

                        <div class="row clearfix">
                            <div class="col-md-4">
                                <b>Client Name</b>                               
                                <div class="form-line">
                                    @Html.TextBoxFor(a => a.clientName, new { tabindex = "1", id = "txtClientName", @class = "form-control required", placeholder = "Client Name" })
                                </div>                               
                            </div>                           
                        </div>                       

                        <div class="row clearfix js-sweetalert">
                            <div>
                                <div class="col-xs-12 ">
                                    <input type="button" id="btnSearch" title="Search" name="Search" value="Search" class="btn bg-green" />
                                    <input type="button" name="reset" id="btnReset" value="Reset" title="Reset" class="btn cancel" />
                                </div>
                            </div>
                        </div>

                        <div style="text-align: right;">
                            <button type="button" id="btnAddNew" title="Add New" >Add New Client</button>
                        </div>
                    </form>
                    <div class="grid-list" id="LoadClientGridData">
                        @{ await Html.RenderPartialAsync("ClientGrid"); }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    // var errormsg = "";
    // var errortype = "";


    // function popmessage(message, type) {
    //     errormsg = message;
    //     errortype = type;
    //     setTimeout("Swal2.Fire('',errormsg,errortype);", 900);
    // }

    $("#btnSearch").click(function () {       
        form = $("#ClientScreen").serialize();
        ReloadDatatable(form);
    });

    $('#btnReset').click(function () {
        $("#txtClientName").val('');
        var form = $('#ClientScreen');
        form.attr("action", '/Client/Index');
        form.submit();
    });

</script>


