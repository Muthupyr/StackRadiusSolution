@model IEnumerable<StackRadius.Entity.NSESchemeMasterModel>
@{
    ViewBag.Title = "NSE Scheme Master";
    ViewData["Title"] = "NSE Scheme master";
    ViewData["AreaKey"] = "nse";
    ViewData["SubAreaKey"] = "nse-scheme";
    ViewData["FooterRight"] = "NSE MFSS Scheme catalogue — refreshed daily from Master_NSE_NSEINVEST_ALL_*.txt";
}

<title>@ViewBag.Title</title>

@*
    Pages/Master/Nse/NseScheme.cshtml
    URL: http://localhost:5220/master/nse/nse-scheme

    Reference DATA GRID page. Shows the shape a "list of records" screen
    takes — CommandBar + full-height sortable table with pill-styled cells.
    A dev cloning this pattern for a new entity (Sip, Mandate, Portfolio, …)
    should copy this file + the code-behind, adjust SchemeRow → their entity,
    and change the <table> columns.
*@

<!-- CommandBar -->
<div class="commandbar">
    <div class="commandbar-entity">
        <svg class="icon"><use href="#i-book" /></svg>
        Scheme [Total Record Count here]
        @*  <span class="count">@Model.Schemes.Count</span> *@
    </div>

    <button type="button" class="commandbar-btn" disabled>
        <svg class="icon"><use href="#i-plus" /></svg>
        Add
    </button>
    <button type="button" class="commandbar-btn">
        <svg class="icon"><use href="#i-refresh" /></svg>
        Refresh from NSE
    </button>
    <div class="commandbar-divider"></div>
    <button type="button" class="commandbar-btn">
        <svg class="icon"><use href="#i-filter" /></svg>
        Filters
    </button>
    <div class="commandbar-right">
        <button type="button" class="commandbar-btn">
            <svg class="icon"><use href="#i-download" /></svg>
            Export CSV
        </button>
        @*  <div class="commandbar-count">@Model.TotalRecords Schemes</div> *@
    </div>
</div>

<div class="grid-wrap">
    <table class="grid-table">
        <thead>
            <tr>
                <th>Unique Sr No</th>
                <th>Scheme Code</th>
                <th>ISIN</th>
                <th>AMC CODE</th>
                <th>Scheme Name</th>
                <th>Scheme Type</th>
                <th class="numeric">Min invest</th>
                <th>Settlement type</th>
                <th>SIP</th>
                <th>STP</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.Count() > 0)
            {
                foreach (var s in Model)
                {
                    @* 
                    var typeTone = s.SchemeType switch
                    {
                        "EQUITY" => "tone-blue",
                        "DEBT" => "tone-amber",
                        "LIQUID" => "tone-purple",
                        "OVERNIGHT" => "tone-slate",
                        "ETF" => "tone-emerald",
                        _ => "tone-slate",
                    }; 
                    *@
                <tr>
                    <td class="mono">@s.unique_sr_no</td>
                    <td class="mono">@s.scheme_code</td>
                    <td class="mono">@s.isin</td>
                    <td>@s.amc_code</td>
                    <td>@s.scheme_name</td>
                    <td><span>@s.scheme_type</span></td>
                    <td class="numeric">₹ @s.new_purchase_min_amount.ToString("N0")</td>
                    <td class="mono">@s.settlement_type</td>
                    <td>@(s.sip_allowed=="Y" ? "✓" : "")</td>
                    <td>@(s.stp_enabled=="Y" ? "✓" : "")</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
