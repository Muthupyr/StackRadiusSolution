    <script type="text/javascript">

    function Process(event) {
        if (event.formName != null) {
            $("#" + event.formName).validate();
            if (!$("#" + event.formName).valid())
                return false;
        }
        $.ajax({
            url: '/' + event.controller + '/' + event.action,
            type: 'POST',
            data: event.data,
            success: function (result) {
                if (result.Status == "Failure") {
                    Swal.fire({
                            title: "Error!",
                            text: result.Message,
                            icon: "error"
                        });
                }
                else {
                    if (event.bindon == null) {
                        if (result.Process == "Save" || result.Process == "Edit") {
                            ProcessSaveUpdate(result.Process, result.Status, result.Message, event.formName)
                        }
                        else {
                            $('#content').html(result);
                        }
                    }
                    else {
                        $(event.bindon).empty();
                        $(event.bindon).html(result);
                    }
                }
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                // Fail-safe check in case the server crashes with a 500 error
                Swal.fire({
                    title: "Server Error",
                    text: "Status: " + textStatus + "Error: " + XMLHttpRequest.responseText,
                    icon: "error"
                });
            }
        });
        return false;
    }
    function ProcessSaveUpdate(process, status, Message, Page) {
        if (status == "Success") {
            if (process == "Save") {
                $(':input').not(':button, :submit, :reset, :hidden, :radio, select').val('');
                $("select").each(function () { this.selectedIndex = 0 });
                if (Page != null) {
                    $("#" + Page).trigger("reset");
                }
                Message = "Record inserted successfully";
            }
            else {
                $("#ModifiedBy").text($('#MasterUser').text());
                var currdate = new Date();
                var currdate = ("0" + currdate.getDate()).slice(-2) + '/' + ("0" + (currdate.getMonth() + 1)).slice(-2) + '/' + currdate.getFullYear() + ' ' + currdate.getHours() + ':' + currdate.getMinutes();
                $("#ModifiedDate").text(currdate);
                Message = "Record updated successfully";
            }
            Swal.fire({title: "Success!",text: Message,icon: "success"});
        }
        else if (status == "Failure") {
            Swal.fire({title: "Error!",text: Message,icon: "error"});
        }
    };

    function GridDelete(event) {
    // Debugging logs (Uncomment if needed)
    // console.log('value:', event.value);
    // console.log('url:', event.url);
    // console.log('table data:', JSON.stringify(event.table));
        Swal.fire({
            title: "Are you sure to delete this record?",
            text: "",
            icon: "warning", // 'type' is now 'icon' in SweetAlert2
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Yes",
            cancelButtonText: "No",
            allowOutsideClick: false // Prevents closing by clicking outside
        }).then((result) => {
            // Check if the user clicked the "Yes" confirm button
            if (result.isConfirmed) {
                $.ajax({
                    url: event.url,
                    type: 'POST',
                    data: {
                        mode: "Delete",
                        value: event.value
                    },
                    success: function (response) {
                        if (response.status === "Success") {
                            event.table
                                .row($(event.maintainvalue).parents('tr'))
                                .remove()
                                .draw(false);

                            Swal.fire({
                                title: "Deleted!",
                                text: response.message,
                                icon: "success"
                            });
                        }
                        else if (response.status === "Failure") {
                            Swal.fire({
                                title: "Error!",
                                text: response.message,
                                icon: "error"
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        // Fail-safe check in case the server crashes with a 500 error
                        Swal.fire({
                            title: "Server Error",
                            text: "Failed to communicate with the server.",
                            icon: "error"
                        });
                    }
                });
            }
        });
    }
</script>

<style>
