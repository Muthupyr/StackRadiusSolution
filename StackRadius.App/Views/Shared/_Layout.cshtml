
@*
    ══════════════════════════════════════════════════════════════════════════
    _Layout.cshtml — the outer chrome every page wears.

    Grid layout (top → bottom):
        ┌───────────────────────────────────────────────────────────────┐
        │ Session band (28px)  — Pages/Shared/_SessionBand.cshtml       │
        ├───────────────────────────────────────────────────────────────┤
        │ Global nav  (48px)  — Pages/Shared/_GlobalNav.cshtml          │
        ├───────────────────────────────────────────────────────────────┤
        │ Breadcrumb          — Pages/Shared/_BreadCrumb.cshtml         │
        ├─────────────┬─────────────────────────────────────────────────┤
        │             │                                                 │
        │  SideMap    │  @RenderBody() — one .cshtml file per URL       │
        │  (256px)    │                                                 │
        │  _SideMap.  │                                                 │
        │  cshtml     │                                                 │
        │             │                                                 │
        ├─────────────┴─────────────────────────────────────────────────┤
        │ Footer  — small monospace strip                                │
        └───────────────────────────────────────────────────────────────┘

    Layout viewdata contract — set per-page in the page's @{} block:
        ViewData["Title"]       = "Master Data home";
        ViewData["AreaKey"]     = "dashboard";       // matches SitemapService area.Key
        ViewData["SubAreaKey"]  = "md-home";         // matches SubArea.Key
    ══════════════════════════════════════════════════════════════════════════
*@

@inject StackRadius.Services.SitemapService Sitemap
@{
    var areaKey = (string)ViewData["AreaKey"] ?? "dashboard";
    var subAreaKey = (string)ViewData["SubAreaKey"];
    var (activeArea, activeSubArea) = Sitemap.FindByKeys(areaKey, subAreaKey);
 
    var breadcrumb = new List<StackRadius.Entity.BreadcrumbItem>
    {
        new("NSE Schemes", "/nse/nsescheme"),
        new(activeArea?.Label ?? areaKey, null),
    };

     if (activeSubArea is not null) breadcrumb.Add(new(activeSubArea.Label, null));
}

