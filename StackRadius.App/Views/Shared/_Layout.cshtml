    <div class="app-shell">
        <partial name="_SessionBand" model="Sitemap.Session" />
        <partial name="_GlobalNav" model="activeArea" />
        <partial name="_BreadCrumb" model="breadcrumb" />
        <div class="app-body">
            <partial name="_SideMap" model="(Sitemap.MasterAppSitemap, areaKey, subAreaKey)" /> 
            <section class="content" id="content">
                @RenderBody()
            </section>
        </div>
        <footer class="app-footer">
