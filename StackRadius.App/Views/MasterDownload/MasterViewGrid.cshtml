@model IEnumerable<StackRadius.Entity.ClientModel>
@{
    ViewBag.Title = "Client List";
    //Layout = "~/Views/Shared/MasterPage.cshtml";
}
<form asp-controller="Client" method="post">   
<div class="container-fluid">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="card">
                <div class="header">
                    <h2>
                        Client List
                    </h2>        
                </div>
                <div class="body">
                    <div class="table-responsive">
                            <button type="submit" asp-action="Add">Add New Client</button>
                            <table id="tblClient" class="table table-bordered table-striped table-hover dataTable js-exportable table-wrap">
                            <thead>
                                <tr>
                                    <th>Client Id</th>
                                    <th>AMC Code</th>
                                    <th>PAN No</th>
                                    <th>Mobile No</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th class="table-action w12">Action</th>
                                </tr>
                            </thead>
                            <tfoot>
                               <tr>
                                    <th>Client Id</th>
                                    <th>AMC Code</th>
                                    <th>PAN No</th>
                                    <th>Mobile No</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th class="table-action w12">Action</th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @if (Model.Count() > 0)
                                {
                                    var Sortlst = Model.OrderBy(x => x.ClientId);
                                    foreach (var lst in Sortlst)
                                    {
                                        <tr>
                                            <td>@lst.ClientId</td>
                                            <td>@lst.amcCode</td>
                                            <td>@lst.panNo</td>
                                            <td>@lst.mobileNo</td>
                                            <td>@lst.invEmail</td>
                                            <td>Active</td>
                                            <td class="table-action w12">
                                                <button type="submit" asp-action="Edit" asp-route-id="@lst.ClientId">Edit</button> 
                                                <a href='#' class='btnDelete' value="@lst.ClientId" title='Delete'>Delete</a> 
                                            </td>
                                        </tr>
                                    }
                                }    
                            </tbody>
                        </table>                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</form>

<script type="text/javascript">
    $('#tblClient').on('click', 'a.btnDelete', function (e) 
    {  
        GridDelete({ value: $(this).attr("value"), table: table = $('#tblClient').DataTable(), maintainvalue: this, url: "/Client/Delete" }); 
     });
 </script>
 

