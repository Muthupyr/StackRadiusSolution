@model IEnumerable<StackRadius.Entity.NSESWPMasterModel>
@{
   Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = "NSE SWP Master";
    ViewData["Title"] = "NSE SWP master";
    ViewData["AreaKey"] = "nse";
    ViewData["SubAreaKey"] = "nseswp";
    ViewData["FooterRight"] = "NSE MFSS SWP catalogue — refreshed daily from NSE";
}

<style>
.button-group {
    display: flex;       /* Forces items into a row */
    gap: 8px;            /* Adds nice spacing between buttons */
    align-items: center; /* Aligns them perfectly vertically */
}
</style>

<title>@ViewBag.Title</title>

@*
    Pages/Nse/NseSWP.cshtml
    URL: http://localhost:5220/nse/NSESWP

    Reference DATA GRID page. Shows the shape a "list of records" screen
    takes — CommandBar + full-height sortable table with pill-styled cells.
    A dev cloning this pattern for a new entity (Sip, Mandate, Portfolio, …)
    should copy this file + the code-behind, adjust SchemeRow → their entity,
    and change the <table> columns.
*@

<form id="frmNSESWP" role="form" class="form-horizontal" method="post" action="javascript:;">
    <input type="hidden" id="FileType" name="FileType"  value="SWP">
    
    <div id="loading-spinner" style="display: none;">
        <div class="spinner"></div> Loading...
    </div>

    <!-- CommandBar -->
    <div class="commandbar">
        <div class="commandbar-entity">
            <svg class="icon"><use href="#i-book" /></svg>
            Scheme [Total Record Count here]
            @*  <span class="count">@Model.Schemes.Count</span> *@
        </div>

        <button type="button"  class="commandbar-btn">            
            <svg class="icon"><use href="#i-plus" /></svg>
            Add
        </button>
        <button type="button" id="btnDownload" class="commandbar-btn">
            <svg class="icon"><use href="#i-refresh" /></svg>
            Refresh from NSE
        </button>
        <div class="commandbar-divider"></div>
        <button type="button" class="commandbar-btn">
            <svg class="icon"><use href="#i-filter" /></svg>
            Filters
        </button>
        <div class="commandbar-right">
            <button type="button" class="commandbar-btn">
                <svg class="icon"><use href="#i-download" /></svg>
                Export CSV
            </button>
            @*  <div class="commandbar-count">@Model.TotalRecords </div> *@
        </div>
    </div>

    <div class="grid-wrap">
        <table id="tblNSESWP" class="grid-table">
            <thead>
                <tr>
                    <th style="width:5%;">                   
                         <input type="checkbox" id="chkbox" class="allchk" disabled="disabled" >
                     </th>
                     <th>Scheme Code</th>                    
                    <th>Scheme Name</th>                    
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() > 0)
                {
                    foreach (var s in Model)
                    {
                        <tr>
                            <td style="width:5%;">
                                @if (@s.nse_scheme_code != "1")
                                {
                                    <input type="checkbox" id="chkbox" class="singlrchk" disabled="disabled"  >
                                }
                                else
                                {
                                    <input type="checkbox" id="chkbox" class="singlrchk" disabled >
                                }
                            </td>
                            <td>@s.nse_scheme_code</td>
                            <td>@s.scheme_name</td>

                            <td>@s.amc_code</td>
                            <td>@s.amc_name</td>
                            <td>@s.nse_scheme_code</td>
                            <td>@s.scheme_name</td>
                            <td>@s.scheme_isin</td>
                            <td>@s.scheme_type</td>
                            <td>@s.aswp_transaction_mode</td>
                            <td>@s.aswp_minimum_installment_amount</td>
                            <td>@s.aswp_maximum_installment_amount</td>
                            <td>@s.aswp_multiplier_amount</td>
                            <td>@s.aswp_minimum_installment_units</td>
                            <td>@s.aswp_maximum_installment_units</td>
                            <td>@s.aswp_multiplier_units</td>
                            <td>@s.aswp_minimum_installment_numbers</td>
                            <td>@s.aswp_maximum_installment_numbers</td>
                            <td>@s.aswp_frequency</td>
                            <td>@s.aswp_dates</td>
                            <td>@s.aswp_minimum_gap</td>
                            <td>@s.aswp_maximum_gap</td>
                            <td>@s.aswp_installment_gap</td>
                            <td>@s.aswp_status</td>

                            <td>
                               <div class="button-group">
                                    <button type="button" id="btnView" value="@s.nse_scheme_code" title="View"> <svg class="icon"><use href="#i-eye" /></svg> </button>
                                    <button type="button" id="btnEdit" value="@s.nse_scheme_code" title="Edit"> <svg class="icon"><use href="#i-edit" /></svg> </button>
                                    <button type="button" id="btnDelete" value="@s.nse_scheme_code" title="Delete"> <svg class="icon"><use href="#i-trash" /></svg> </button>
                               </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</form>

<script>
    $('#btnDownload').click(function() {
 
        const spinner = document.getElementById('loading-spinner');

         // 1. Show the spinner before starting the request
         spinner.style.display = 'block';

        $("#btnDownload").prop('disabled', true);
         var x = $("#frmNSESWP").serialize();
         //alert('data: ' + JSON.stringify(x));

        var fileType = $("#FileType").val(); // "SWP"
        //swal("", "Selected file type : " + fileType + ".", "success");
        if (fileType == "" || fileType == null) {  
            swal("", "Please select a File Type. FileType :" + fileType + ".", "error");
            $("#btnDownload").prop('disabled', false);
            return false;
        }

        $.ajax({
            url: '@Url.Action("DownloadFile", "MasterDownload")',
            type: 'POST',
            data: $("#frmNSESWP").serialize(),

            success: function(result) {
                // alert('result: ' + JSON.stringify(result));
                // console.log(result);
                // alert('message: ' + result.message);
                // alert('status: ' + result.status);

                if (result.status == "Success") {
                    //swal("", result.message, "success");

                    swal({
                        title: "",
                        text: result.message,
                        type: "success",
                        closeOnConfirm: false,
                        confirmButtonText: "OK",
                        confirmButtonColor: "success"
                    }, function (isConfirm) {
                        if (isConfirm) {
                            // reload with the new data
                            window.location.href = '@Url.Action("Index", "NSESWP")'
                        }
                    });

                    $("#btnDownload").prop('disabled', false);
  
                }
                else {
                    swal("", result.message, "error");
                    $("#btnDownload").prop('disabled', false);
                }
                spinner.style.display = 'none';
            },
            error: function(xhr, status, error) {
                swal("", "Error occurred while downloading file : " + error, "error");
                $("#btnDownload").prop('disabled', false);
                spinner.style.display = 'none';
            }
        });
    });

</script>