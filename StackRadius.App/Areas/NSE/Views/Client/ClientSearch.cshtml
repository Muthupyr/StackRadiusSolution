@using System.Data

@model StackRadius.Entity.ClientModel
@{
    ViewBag.Title = "Client Search";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Advanced Select -->
<div class="sr-commandbar">
    <div class="sr-commandbar__left">
        <span class="sr-commandbar__title">Clients</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-sr-refresh>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" /><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" /></svg>
            Refresh
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-sr-filter-toggle>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-2 .667A.5.5 0 0 1 7 14.5V8.692L2.628 3.834A.5.5 0 0 1 2.5 3.5v-2z" /></svg>
            Filter
        </button>
        <a class="btn btn-sm btn-outline-secondary" href="#" data-sr-export>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" /></svg>
            Export
        </a>
    </div>
    <div class="sr-commandbar__right">
        <!-- Columns menu -->
        <div class="dropdown">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside">Columns</button>
            <div class="dropdown-menu dropdown-menu-end" data-sr-cols></div>
        </div>
        <!-- Density menu -->
        <div class="dropdown">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">Density</button>
            <div class="dropdown-menu dropdown-menu-end">
                <button type="button" class="dropdown-item" data-d="compact">Compact</button>
                <button type="button" class="dropdown-item" data-d="default">Default</button>
                <button type="button" class="dropdown-item" data-d="comfortable">Comfortable</button>
            </div>
        </div>
        <input type="search" class="form-control form-control-sm sr-commandbar__quick" data-sr-quick placeholder="Filter across columns…">
        <span class="sr-commandbar__count"><span data-sr-total>…</span> records</span>
        <span class="badge text-bg-primary" data-sr-selection hidden></span>
    </div>
</div>
<div class="container-fluid page">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <!-- Header: title on the left, search icon + Add New on the right -->
                <div class="sr-page__title ps-0">
                    <h1>Clients</h1>
                    <div class="header-actions ms-auto">
                        <button type="button" id="btnToggleSearch" class="btn btn-outline-secondary btn-icon"
                                title="Search" aria-label="Show search" aria-expanded="false">
                            <svg class="icon"><use href="#i-search" /></svg>
                        </button>
                        <button type="button" id="btnAddNew" class="btn btn-primary" title="Add New">+ Add New Client</button>
                    </div>
                </div>

                <div class="card-body">
                    <form id="ClientScreen" role="form" method="post" action="" enctype="multipart/form-data">

                        <!-- Search panel: hidden until the search icon is clicked -->
                        <div id="searchPanel" class="search-panel d-none">
                            <div class="search-bar js-sweetalert">
                                @Html.TextBoxFor(a => a.clientName, new { tabindex = "1", id = "txtClientName", @class = "form-control required", placeholder = "Client Name", aria_label = "Client Name" })
                                <input type="button" id="btnSearch" title="Search" name="Search" value="Search" class="btn btn-dark" />
                                <input type="button" name="reset" id="btnReset" value="Reset" title="Reset" class="btn btn-outline-secondary cancel" />
                            </div>
                        </div>

                    </form>
                   
                    <div id="clientGrid" style="height:600px"></div>
                    <div class="grid-list" id="LoadClientGridData">
                        @{
                            await Html.RenderPartialAsync("ClientGrid");
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
                        
<script>        
    // Toggle search panel 
    $(document).on('click', '#btnToggleSearch', function () {
        var $panel = $('#searchPanel');
        $panel.toggleClass('d-none');
        var isOpen = !$panel.hasClass('d-none');
        $(this).attr('aria-expanded', isOpen);
        if (isOpen) {$('#txtUserName').trigger('focus'); }
    });

    // SEARCH → reload the grid (it re-reads #txtClientName automatically)
    $(document).on('click', '#btnSearch', function () {
        ReloadDatatable();
    });

    // Optional: press Enter in the box = Search
    $(document).on('keypress', '#txtUserName', function (e) {
        if (e.which === 13) {e.preventDefault(); ReloadDatatable(); }
    });

    // RESET → clear the box, then reload to show everything again
    $(document).on('click', '#btnReset', function () {
        $('#txtUserName').val('');
            ReloadDatatable();
        })
</script>
