@* Script for the grid so the grid can clicked 
<script>
    document.querySelectorAll('.grid-table tbody tr').forEach(function (tr) {
        tr.addEventListener('click', function () {
            document.querySelector('.grid-wrap').classList.add('d-none');
            document.querySelector('.commandbar').classList.add('d-none');
            document.getElementById('detail-' + tr.dataset.code).classList.remove('d-none');
            window.scrollTo(0, 0);
        });
    });

    document.querySelectorAll('.close-detail').forEach(function (btn) {
        btn.addEventListener('click', function () {
            btn.closest('.detail-pane').classList.add('d-none');
            document.querySelector('.grid-wrap').classList.remove('d-none');
            document.querySelector('.commandbar').classList.remove('d-none');
        });
    });
</script>
