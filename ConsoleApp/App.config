	</appSettings>

	<!-- Your existing system.net section can now reside safely below -->
	<system.net>
		<mailSettings>
			<smtp deliveryMethod="Network" from="admin@openwavecomp.in">
				<network host="smtp.openwavecomp.in" port="587" userName="admin@openwavecomp.in" password="Sterling#2010" defaultCredentials="false"/>
			</smtp>
		</mailSettings>
	</system.net>
	<log4net>
		<appender name="LoggerRollingFileAppender" type="log4net.Appender.RollingFileAppender">
			<file value="C:\StackRadiusSolution\Logs\StackRadius.Service_"/>
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd'.log'" />
			<maxSizeRollBackups value="100" />
			<maximumFileSize value="10000KB" />
			<staticLogFileName value="false" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%d{yyyy-MM-dd hh:mm:ss} - %message%newline" />
			</layout>
		</appender>
		<logger name="Logger">
			<level value="ALL" />
			<appender-ref ref="LoggerRollingFileAppender" />
		</logger>
	</log4net>
</configuration>